# =========================
# DATABASE
# =========================
# PostgreSQL connection string (Supabase o local)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# =========================
# AUTH
# =========================
# Secreto para firmar los tokens de sesión. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si no se define, se deriva de DATABASE_URL (funciona, pero conviene setearlo
# explícito en producción y rotarlo invalida todas las sesiones).
AUTH_SECRET=

# =========================
# FEATURE FLAGS (Optional)
# =========================
# Entregadas por configuración, no por build. El frontend las lee vía GET /config.
# Default false: la feature queda inerte hasta activarla acá.
# Event Access v1 (link para compartir + share code):
# EVENT_ACCESS_ENABLED=false
# Contraseña de evento (sub-feature de Event Access):
# EVENT_PASSWORDS_ENABLED=false
# Inscripción externa sin cuenta (Iteración 2):
# EXTERNAL_REGISTRATION_ENABLED=false
# Clave Fernet para cifrar el contacto del externo en reposo. Si no se define,
# se deriva de AUTH_SECRET. Generar una propia con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# EXTERNAL_CONTACT_KEY=
# Días de retención de PII externa (solo documenta la política; el borrado es tarea posterior):
# EXTERNAL_PII_RETENTION_DAYS=30
# Reservado para fase futura:
# ACCOUNT_APPROVAL_ENABLED=false

# =========================
# CORS (Optional)
# =========================
# Orígenes permitidos, separados por coma.
# Si no se define, usa defaults de desarrollo (localhost:5173).
# En producción con Railway no es necesario (frontend se sirve desde el mismo origen).
# CORS_ORIGINS=https://mi-app.up.railway.app,http://localhost:5173
