# Railway inyecta PORT.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Archivos con hash en el nombre: caché de un año.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Logos y escudos: un día.
	@media path /brand/* /teams/*
	header @media Cache-Control "public, max-age=86400"

	# Todo lo demás (index.html y rutas del SPA): siempre revalidar, así cada deploy llega al instante.
	@html not path /assets/* /brand/* /teams/*
	header @html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Rutas del SPA (/fixture, /equipos/..., /v/<token>) → index.html
	try_files {path} /index.html
	file_server
}
